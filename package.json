{
  "name": "dip-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "docs:validate": "node scripts/validate-docs.mjs",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "test:unit": "node --experimental-strip-types --test \"tests/unit/*.test.ts\"",
    "test:contract": "node --experimental-strip-types --test \"tests/contract/*.test.ts\"",
    "test:security": "node --experimental-strip-types --test \"tests/security/*.test.ts\"",
    "ci:check": "npm run lint && npm run docs:validate && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "mermaid": "^12.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.2"
  }
}
